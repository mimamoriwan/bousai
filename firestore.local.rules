rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGoogleUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function validCoordinates(data) {
      return data.lat is number
        && data.lng is number
        && data.lat >= -90
        && data.lat <= 90
        && data.lng >= -180
        && data.lng <= 180;
    }

    function validPinDetails(data) {
      let tags = data.get('tags', []);
      return data.get('pinKind', 'alert') in ['alert', 'memo']
        && data.get('locationPrecision', 'point') in ['point', 'area']
        && data.get('isLitter', false) is bool
        && tags is list
        && tags.hasOnly(['地域', '春', '夏', '秋', '冬', '雨の日'])
        && tags.size() == tags.toSet().size()
        && (!('createdAt' in data) || data.createdAt == request.time)
        && (!('observedAt' in data)
          || (data.observedAt is int
            && data.observedAt > 0
            && data.observedAt <= request.time.toMillis() + 300000));
    }

    function ownReactionHash() {
      // src/utils/hashUtils.js と同じ公開用識別子。旧版の反応には生の UID が残っている。
      return hashing.sha256('bousai-map-v1' + request.auth.uid).toHexString().lower();
    }

    function validPinOwner(data) {
      return data.keys().hasAny(['uid', 'ownerUid'])
        && data.get('uid', request.auth.uid) == request.auth.uid
        && data.get('ownerUid', request.auth.uid) == request.auth.uid;
    }

    function validPinImagePath(data) {
      let path = data.get('imagePath', null);
      return path == null || (path is string && (
        (data.visibility == 'public' && path.matches('map_pins/' + request.auth.uid + '/[^/]+'))
        || (data.visibility == 'private' && data.get('imageUrl', null) == null
          && path.matches('private_map_pins/' + request.auth.uid + '/[^/]+'))
        || (!('ownerUid' in data) && path.matches('map_pins/[0-9]+[.](jpg|jpeg|png|webp)'))
      ));
    }

    function validMapPinCreate() {
      return request.resource.data.keys().hasOnly([
          'lat', 'lng', 'type', 'title', 'note', 'date', 'timestamp',
          'imageUrl', 'imagePath', 'resolved', 'thanks', 'savedBy',
          'visibility', 'userHash', 'ownerUid', 'pinKind', 'tags',
          'locationPrecision', 'isLitter', 'observedAt', 'createdAt', 'uid', 'memberNumber'
        ])
        && request.resource.data.keys().hasAll([
          'lat', 'lng', 'type', 'title', 'note', 'date', 'timestamp',
          'resolved', 'thanks', 'savedBy', 'visibility'
        ])
        && validPinOwner(request.resource.data)
        && (request.resource.data.get('memberNumber', null) == null
          || (request.resource.data.memberNumber is int && request.resource.data.memberNumber > 0))
        && validCoordinates(request.resource.data)
        && validPinDetails(request.resource.data)
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 50
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 30
        && request.resource.data.timestamp is int
        && request.resource.data.resolved == false
        && request.resource.data.thanks is list
        && request.resource.data.thanks.size() == 0
        && request.resource.data.savedBy is list
        && request.resource.data.savedBy.size() == 0
        && request.resource.data.visibility in ['public', 'private']
        && (!request.resource.data.keys().hasAll(['imageUrl'])
          || request.resource.data.imageUrl == null
          || request.resource.data.imageUrl is string)
        && validPinImagePath(request.resource.data)
        && (request.resource.data.get('userHash', null) == null
          || request.resource.data.userHash == ownReactionHash());
    }

    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validInteraction(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data[field];
      let uid = request.auth.uid;
      let alias = ownReactionHash();
      let ownIds = [uid, alias];
      return resource.data.visibility == 'public' && before is list && after is list
        && ((!before.hasAny(ownIds) && after.size() <= 500
            && (after == before.concat([uid]) || after == before.concat([alias])))
          || (after.size() < before.size()
            && (after == before.removeAll([uid]) || after == before.removeAll([alias])
              || after == before.removeAll(ownIds))));
    }

    function pinPath(id) {
      return /databases/$(database)/documents/map_pins/$(id);
    }

    function cleanupPath(id) {
      return /databases/$(database)/documents/pinCleanups/$(id);
    }

    function receiptPath(id, uid) {
      return /databases/$(database)/documents/pinCleanups/$(id)/thanks/$(uid);
    }

    function isOpenAlert(data) {
      return data.visibility == 'public'
        && (data.get('pinKind', null) == 'alert'
          || (!('pinKind' in data) && data.type in ['danger', 'plant']))
        && data.get('resolved', false) == false && data.get('cleanedAt', null) == null;
    }

    function isLitter(data) {
      return data.type == 'danger' && data.get('isLitter', data.title == 'ゴミが落ちてるよ') == true;
    }

    function millis(value) {
      return value is timestamp ? value.toMillis() : (value is int ? value : 0);
    }

    function canReconfirm(data) {
      let created = millis(data.get('createdAt', null));
      let postedMs = created > 0 ? created : millis(data.get('timestamp', null));
      let age = request.time.toMillis() - postedMs;
      return isOpenAlert(data) && data.get('confirmedAt', null) == null
        && postedMs > 0
        && age >= 86400000 && age <= 172800000
        && request.resource.data.confirmedAt == request.time;
    }

    function validCleanupUpdate(id) {
      let after = request.resource.data;
      return changesOnly(['resolved', 'cleanedAt', 'cleanerUid'])
        && isOpenAlert(resource.data) && isLitter(resource.data)
        && after.resolved == true && after.cleanedAt == request.time
        && after.cleanerUid == request.auth.uid
        && !exists(cleanupPath(id))
        && getAfter(cleanupPath(id)).data.cleanedAt == request.time;
    }

    match /map_pins/{postId} {
      allow read: if resource.data.visibility == 'public';
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn() && validMapPinCreate()
        && !exists(cleanupPath(postId));

      allow update: if isSignedIn() && (
        (validPinOwner(resource.data)
          && resource.data.get('cleanedAt', null) == null
          && changesOnly(['resolved'])
          && request.resource.data.resolved is bool)
        || (changesOnly(['thanks']) && validInteraction('thanks'))
        || (changesOnly(['savedBy'])
          && validInteraction('savedBy'))
        || (changesOnly(['confirmedAt']) && canReconfirm(resource.data))
        || validCleanupUpdate(postId)
      );

      allow delete: if isSignedIn()
        && validPinOwner(resource.data);
    }

    match /pinCleanups/{postId} {
      function validCleanupCreate() {
        let before = get(pinPath(postId)).data;
        let after = getAfter(pinPath(postId)).data;
        let entry = request.resource.data;
        return isOpenAlert(before) && isLitter(before)
          && after.cleanedAt == request.time && after.resolved == true
          && after.cleanerUid == request.auth.uid
          && entry.keys().hasOnly(['cleanerUid', 'title', 'cleanedAt', 'thanksCount'])
          && entry.cleanerUid == request.auth.uid && entry.title == before.title
          && entry.cleanedAt == request.time && entry.thanksCount == 0;
      }

      function validCleanupThanks() {
        let receipt = receiptPath(postId, request.auth.uid);
        return changesOnly(['thanksCount'])
          && request.resource.data.thanksCount == resource.data.thanksCount + 1
          && resource.data.cleanerUid != request.auth.uid
          && exists(pinPath(postId))
          && !exists(receipt) && getAfter(receipt).data.createdAt == request.time;
      }

      allow get: if (isSignedIn() && resource.data.cleanerUid == request.auth.uid)
        || get(pinPath(postId)).data.visibility == 'public';
      allow list: if isSignedIn() && resource.data.cleanerUid == request.auth.uid;
      allow create: if isSignedIn() && validCleanupCreate();
      allow update: if isSignedIn() && validCleanupThanks();

      match /thanks/{uid} {
        allow get: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && get(cleanupPath(postId)).data.cleanerUid != uid
          && getAfter(cleanupPath(postId)).data.thanksCount
            == get(cleanupPath(postId)).data.thanksCount + 1;
      }
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /routes/{routeId} {
        allow read, create, update, delete: if isOwner(uid) && isGoogleUser();
      }
    }

    match /metadata/counters {
      allow read: if isGoogleUser();
      allow create: if isGoogleUser()
        && request.resource.data.keys().hasOnly(['memberCount'])
        && request.resource.data.memberCount == 1;
      allow update: if isGoogleUser()
        && request.resource.data.keys().hasOnly(['memberCount'])
        && request.resource.data.memberCount == resource.data.memberCount + 1;
      allow delete: if false;
    }

    match /walkActions/{actionId} {
      allow read, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'actionType', 'lat', 'lng', 'timestamp', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'actionType', 'lat', 'lng', 'timestamp', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && validCoordinates(request.resource.data)
        && request.resource.data.actionType in ['sniff', 'pee', 'poop', 'mark']
        && request.resource.data.timestamp is int
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // 正確なwalkActionsは公開せず、Cloud Functionsが作る週・約250mセルだけを公開する。
    // 同じ利用者の連打で公開されないよう、3人以上のセルに限定する。
    match /walkHeatmapPeriods/{periodId}/cells/{cellId} {
      // 3人未満のセルはCloud Functionsがこの公開コレクションへ作成しない。
      // クライアントは公開済みセルだけを一覧取得できる。
      allow read: if true;
      allow write: if false;
    }

    // 集約の重複防止とUID別内訳はAdmin SDK専用。クライアントには一切公開しない。
    match /_walkHeatmapContributions/{document=**} {
      allow read, write: if false;
    }

    match /_walkHeatmapAggregates/{document=**} {
      allow read, write: if false;
    }

    match /_walkHeatmapEvents/{document=**} {
      allow read, write: if false;
    }

    function ownsSafetyReport(data) {
      return (data.keys().hasAll(['uid']) && data.uid == request.auth.uid)
        || (data.keys().hasAll(['userId']) && data.userId == request.auth.uid);
    }

    match /safetyReports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn()
        && ownsSafetyReport(request.resource.data);
      allow delete: if isSignedIn() && ownsSafetyReport(resource.data);
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
